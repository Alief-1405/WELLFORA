{
  "name": "wellfora",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "seed": "npm --prefix apps/api run db:seed",
    "build": "npm --prefix apps/web run build && npm --prefix apps/api run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^8.0.0-rc.33"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1"
  }
}
